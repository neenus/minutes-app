FROM node:22
WORKDIR /app

ARG NPM_TOKEN

COPY .npmrc package*.json ./
COPY server/package.json ./server/
COPY client/package.json ./client/
RUN npm ci

# Pre-download MongoDB binary into the cache layer so it doesn't re-download on source changes
ENV MONGOMS_DOWNLOAD_DIR=/app/server/node_modules/.cache/mongodb-memory-server
RUN cd server && node -e "require('mongodb-memory-server').MongoMemoryServer.create().then(s=>s.stop()).then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})"

COPY server/ ./server/
COPY client/ ./client/

RUN npx tsc --noEmit --project server/tsconfig.json
RUN npm test --workspace=server
RUN npx tsc --noEmit --project client/tsconfig.json
RUN npm run lint --workspace=client
