pipeline {
  agent any

  tools {
    nodejs '22.12.0'
  }

  environment {
    REGISTRY = '192.168.4.99:5101'
    IMAGE    = "${REGISTRY}/minutes-api"
  }

  stages {
    stage('Checkout') {
      steps {
        deleteDir()
        checkout scm
      }
    }

    stage('Install') {
      steps {
        dir('server') {
          withCredentials([string(credentialsId: 'npm-private-token', variable: 'NPM_TOKEN')]) {
            sh 'npm ci'
          }
        }
      }
    }

    stage('Type Check') {
      steps {
        dir('server') { sh 'npx tsc --noEmit' }
      }
    }

    stage('Lint') {
      when {
        expression {
          return sh(
            script: 'node -e "require(\'./server/package.json\').scripts.lint || process.exit(1)"',
            returnStatus: true
          ) == 0
        }
      }
      steps {
        dir('server') { sh 'npm run lint' }
      }
    }

    stage('Test') {
      when { expression { return fileExists('server/src/__tests__') } }
      steps {
        dir('server') { sh 'npm test' }
      }
    }

    stage('Docker Build & Push') {
      when { branch 'main' }
      steps {
        dir('server') {
          withCredentials([string(credentialsId: 'npm-private-token', variable: 'NPM_TOKEN')]) {
            sh """
              docker build --build-arg NPM_TOKEN=${NPM_TOKEN} -t ${IMAGE}:${BUILD_NUMBER} -t ${IMAGE}:latest .
              docker push ${IMAGE}:${BUILD_NUMBER}
              docker push ${IMAGE}:latest
            """
          }
        }
      }
    }

    stage('DB Backup') {
      when { branch 'main' }
      steps {
        sh 'docker exec minutes-mongo mongodump --out /backup/pre-deploy-${BUILD_NUMBER} 2>&1 || echo "Backup skipped (container not running yet)"'
      }
    }

    stage('Deploy') {
      when { branch 'main' }
      steps {
        build job: 'minutes-deploy', wait: false
      }
    }
  }

  post {
    failure { echo 'Pipeline failed — check stage output above.' }
    success { echo 'Pipeline completed successfully.' }
  }
}
